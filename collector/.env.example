# 복사해서 .env로 저장 후 값 입력:  cp .env.example .env && chmod 600 .env
IMAP_HOST=gw.z-tec.co.kr
IMAP_PORT=993
IMAP_USER=jinyong.byun@z-tec.co.kr
IMAP_PASS=여기에_비밀번호
IMAP_FOLDERS=Inbox,Sent
FETCH_BATCH=20

# labrag-pg (같은 서버의 Docker 컨테이너, 포트 5435)
PG_DSN=host=127.0.0.1 port=5435 dbname=labrag user=labrag password=여기에_DB비밀번호

# 원본 .eml / 첨부 저장 위치
DATA_DIR=/home/redmine/mail-collector/data
LOG_LEVEL=INFO
